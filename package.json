{
  "name": "crafted-cloud-functions",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "functions/creator-outreach"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "nx run-many -t lint",
    "format": "nx run-many -t format",
    "check": "nx run-many -t check",
    "check:ci": "nx run-many -t check:ci --output-style=stream",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:ci": "nx run-many -t test:ci --output-style=stream",
    "commitlint": "commitlint --edit",
    "cz": "cz",
    "lint-staged": "lint-staged",
    "clean": "nx run-many -t clean && rimraf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "nx": "^22.5.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.2",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
